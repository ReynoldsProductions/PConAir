{
  "id": "news",
  "name": "Faire Wire",
  "version": "2.0.0",
  "description": "Ticker with the Faire logo bug, plus left/right lower thirds. Take them as separate renders or as one all-in-one render. TAKE/CLEAR driven.",
  "renders": [
    {
      "id": "ticker",
      "label": "Ticker + logo bug",
      "file": "render-ticker.html"
    },
    {
      "id": "l3",
      "label": "Lower thirds (left + right)",
      "file": "render-l3.html"
    },
    {
      "id": "all",
      "label": "Ticker + lower thirds (one source)",
      "file": "render-all.html",
      "preset": {
        "name": "Faire Wire — Ticker + lower thirds",
        "description": "Both Faire Wire layers in one browser source. Hide each piece from the Faire Wire control panel or Companion."
      }
    }
  ],
  "stateSchema": {
    "theme": "string",
    "logo": "string",
    "brand": {
      "font": "string",
      "accent": "string"
    },
    "l3Left": {
      "visible": "boolean",
      "name": "string",
      "title": "string",
      "subtitle": "string"
    },
    "l3Right": {
      "visible": "boolean",
      "name": "string",
      "title": "string",
      "subtitle": "string"
    },
    "tickerItems": "array",
    "tickerVisible": "boolean",
    "tickerSeconds": "number",
    "logoScale": "number",
    "autoClear": "boolean",
    "autoClearSeconds": "number",
    "logoAsset": "string",
    "timeBug": {
      "visible": "boolean",
      "liveVisible": "boolean",
      "timezone": "string",
      "format": "string"
    }
  },
  "initialState": {
    "theme": "default",
    "logo": "tan",
    "brand": {
      "font": "inter",
      "accent": ""
    },
    "l3Left": {
      "visible": false,
      "name": "Jane Smith",
      "title": "Chief Executive Officer",
      "subtitle": ""
    },
    "l3Right": {
      "visible": false,
      "name": "Alex Chen",
      "title": "Head of Supply",
      "subtitle": ""
    },
    "tickerItems": [
      "KW:: Tens of engineers displaced after flooding in KW, prompting AI-powered mop project for Hack Week",
      "NYC:: 12th floor declared official icebox, 10th floor still sweating it out",
      "SF:: Wagon Rock frontman steps down, Faire COO Jeff Kolovson considers auditioning",
      "KW:: Ghost of iPad Jim spotted haunting the new espresso machine",
      "SF:: Bevi machine out of CO2 for the third time, employees consider rationing bubbles",
      "NYC:: Employee asks \"is there like, a vote?\" on the AC, no referendum scheduled",
      "KW:: Local hero returns MacBook after two years and 59 stickers, KW office mourns",
      "Shadow Top 8 caucus keeps biweekly slot with Max, insiders confirm",
      "KW:: Evil parking man strikes again, ghost of iPad Jim spotted in his driver's seat",
      "TOR:: Dark blue phone found on 2nd floor, finder invokes 'finders keepers' in thread",
      "KW:: Capybara plush sells out in four minutes flat, Sculptor neighbourhood in mourning",
      "SF:: Nespresso jams again, SF third floor declares state of emergency",
      "Meeting cap quietly raised from 9 to 15, math abandoned",
      "NYC:: Workplace ops caught between hot meeting rooms and cold open floor, diplomacy fails",
      "KW:: Ghost of iPad Jim blamed for grounds left in espresso machine, again",
      "SF:: Volunteer sign-up sheet turns cutthroat, Faire Summer Give Back \"not a competition\" officially a competition",
      "TOR:: BEEP shuttle capped at 10 passengers, waitlist treated like Studio 54 guest list",
      "Top 8 hopefuls brace for reshuffle, sources say \"they'll change\" again",
      "LON:: Sources: espresso machine \"having a moment,\" employees strongly request an upgrade",
      "NYC:: Max's Corner sells $34 umbrellas mid-downpour, capitalism wins",
      "KW:: Hot water tank floods office, HR clarifies this is not a metaphor",
      "SF:: Wagon Rock camp denies Kolovson audition rumors, sources call \"no comment\" a maybe",
      "TOR:: Office library honor system holds strong, one overdue biography under internal investigation",
      "Planning feedback survey sent again, response rate holds steady at zero",
      "LON:: Football sweepstake crowns office champion, Golden Boot goes uncontested"
    ],
    "tickerVisible": true,
    "tickerSeconds": 180,
    "logoScale": 100,
    "autoClear": false,
    "autoClearSeconds": 8,
    "logoAsset": "",
    "timeBug": {
      "visible": false,
      "liveVisible": true,
      "timezone": "America/New_York",
      "format": "12h"
    }
  },
  "companionActions": [
    {
      "id": "news_l3_left_take",
      "label": "Take lower third — LEFT",
      "options": [
        {
          "id": "name",
          "label": "Name",
          "type": "textinput",
          "default": ""
        },
        {
          "id": "title",
          "label": "Title",
          "type": "textinput",
          "default": ""
        },
        {
          "id": "subtitle",
          "label": "Subtitle",
          "type": "textinput",
          "default": ""
        }
      ],
      "ops": [
        {
          "op": "set",
          "field": "l3Left.name",
          "value": {
            "option": "name",
            "orState": "l3Left.name"
          }
        },
        {
          "op": "set",
          "field": "l3Left.title",
          "value": {
            "option": "title",
            "orState": "l3Left.title"
          }
        },
        {
          "op": "set",
          "field": "l3Left.subtitle",
          "value": {
            "option": "subtitle",
            "orState": "l3Left.subtitle"
          }
        },
        {
          "op": "set",
          "field": "l3Left.visible",
          "value": true
        }
      ]
    },
    {
      "id": "news_l3_left_clear",
      "label": "Clear lower third — LEFT",
      "ops": [
        {
          "op": "set",
          "field": "l3Left.visible",
          "value": false
        }
      ]
    },
    {
      "id": "news_l3_right_take",
      "label": "Take lower third — RIGHT",
      "options": [
        {
          "id": "name",
          "label": "Name",
          "type": "textinput",
          "default": ""
        },
        {
          "id": "title",
          "label": "Title",
          "type": "textinput",
          "default": ""
        },
        {
          "id": "subtitle",
          "label": "Subtitle",
          "type": "textinput",
          "default": ""
        }
      ],
      "ops": [
        {
          "op": "set",
          "field": "l3Right.name",
          "value": {
            "option": "name",
            "orState": "l3Right.name"
          }
        },
        {
          "op": "set",
          "field": "l3Right.title",
          "value": {
            "option": "title",
            "orState": "l3Right.title"
          }
        },
        {
          "op": "set",
          "field": "l3Right.subtitle",
          "value": {
            "option": "subtitle",
            "orState": "l3Right.subtitle"
          }
        },
        {
          "op": "set",
          "field": "l3Right.visible",
          "value": true
        }
      ]
    },
    {
      "id": "news_l3_right_clear",
      "label": "Clear lower third — RIGHT",
      "ops": [
        {
          "op": "set",
          "field": "l3Right.visible",
          "value": false
        }
      ]
    },
    {
      "id": "news_l3_clear_both",
      "label": "Clear both lower thirds",
      "ops": [
        {
          "op": "set",
          "field": "l3Left.visible",
          "value": false
        },
        {
          "op": "set",
          "field": "l3Right.visible",
          "value": false
        }
      ]
    },
    {
      "id": "news_set_ticker",
      "label": "Set ticker items",
      "options": [
        {
          "id": "items",
          "label": "Items (separate with |, use lead:: rest to accent the lead-in)",
          "type": "textinput",
          "default": ""
        }
      ],
      "ops": [
        {
          "op": "set",
          "field": "tickerItems",
          "value": {
            "option": "items",
            "split": "|"
          }
        },
        {
          "op": "set",
          "field": "tickerVisible",
          "value": true
        }
      ]
    },
    {
      "id": "news_clear_ticker",
      "label": "Clear ticker",
      "ops": [
        {
          "op": "set",
          "field": "tickerVisible",
          "value": false
        }
      ]
    },
    {
      "id": "news_toggle_autoclear",
      "label": "Toggle lower-third auto-clear",
      "ops": [
        {
          "op": "toggle",
          "field": "autoClear"
        }
      ]
    },
    {
      "id": "news_toggle_time_bug",
      "label": "Toggle time/live bug",
      "ops": [
        {
          "op": "toggle",
          "field": "timeBug.visible"
        }
      ]
    },
    {
      "id": "news_toggle_time_bug_live",
      "label": "Toggle LIVE indicator on time bug",
      "ops": [
        {
          "op": "toggle",
          "field": "timeBug.liveVisible"
        }
      ]
    }
  ],
  "companionFeedbacks": [
    {
      "id": "l3_left_visible",
      "label": "Lower third LEFT on air",
      "field": "l3Left.visible"
    },
    {
      "id": "l3_right_visible",
      "label": "Lower third RIGHT on air",
      "field": "l3Right.visible"
    },
    {
      "id": "ticker_visible",
      "label": "Ticker visible",
      "field": "tickerVisible"
    },
    {
      "id": "autoclear_on",
      "label": "Auto-clear enabled",
      "field": "autoClear"
    },
    {
      "id": "time_bug_visible",
      "label": "Time bug visible",
      "field": "timeBug.visible"
    },
    {
      "id": "time_bug_live",
      "label": "Time bug LIVE indicator on",
      "field": "timeBug.liveVisible"
    }
  ],
  "companionVariables": [
    {
      "id": "l3_left_name",
      "label": "Lower third LEFT name",
      "field": "l3Left.name"
    },
    {
      "id": "l3_left_title",
      "label": "Lower third LEFT title",
      "field": "l3Left.title"
    },
    {
      "id": "l3_right_name",
      "label": "Lower third RIGHT name",
      "field": "l3Right.name"
    },
    {
      "id": "l3_right_title",
      "label": "Lower third RIGHT title",
      "field": "l3Right.title"
    }
  ],
  "transientFields": [
    "l3Left.visible",
    "l3Right.visible"
  ]
}
